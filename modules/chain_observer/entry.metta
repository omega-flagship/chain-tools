(Module omegahive.chain.observer)
(ModuleKind omegahive.chain.observer external-info-organ)
(ModuleVersion omegahive.chain.observer "0.1.0")
(ModuleEntrypoint omegahive.chain.observer "entry.metta")
(ModuleOptional omegahive.chain.observer True)
(ModuleDefaultEnabled omegahive.chain.observer False)
(ModuleImplementation omegahive.chain.observer observer-http)
(Provides omegahive.chain.observer (Skill chain-status))
(Provides omegahive.chain.observer (Skill chain-finalized-block))
(Provides omegahive.chain.observer (Skill chain-query))
(Provides omegahive.chain.observer (Skill chain-query-at))
(Provides omegahive.chain.observer (Skill chain-query-base64))
(Provides omegahive.chain.observer (Skill chain-query-at-base64))
(RuntimeDependency omegahive.chain.observer python ">=3.12")
(OrganPrinciple omegahive.chain.observer "Queries read a local observer snapshot; no signing, consensus deploy submission or block proposal is provided.")

!(import! &self (car-atom (collapse (library OmegaClaw-Core ./modules/chain_observer/src/chain_observer.py))))
!(import! &self (library OmegaClaw-Core ./modules/chain_observer/catalog.metta))
!(import! &self (library OmegaClaw-Core ./modules/chain_observer/affordance.metta))
!(import! &self (library OmegaClaw-Core ./modules/chain_observer/signatures.metta))
!(import! &self (library OmegaClaw-Core ./modules/chain_observer/skills.metta))

